# Hoist shared dev dependencies to root for consistency
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=*turbo*
public-hoist-pattern[]=*husky*
public-hoist-pattern[]=*lint-staged*

# Allow workspaces to have their own versions of runtime dependencies
# This prevents conflicts when different apps need different versions
shamefully-hoist=false
