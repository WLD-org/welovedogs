{
  "name": "stellar-startup-template",
  "version": "1.0.0",
  "private": true,
  "description": "Stellar startup template with Next.js, Supabase, and Soroban contracts",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "node -e \"if (!process.env.CI && !process.env.VERCEL) { try { require('husky')() } catch(e) {} }\" || true"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "trustedDependencies": [
    "@reown/appkit",
    "protobufjs",
    "tiny-secp256k1"
  ]
}
