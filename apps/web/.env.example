# Solana network configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# USDC SPL token mint (devnet default: Circle USDC)
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Platform wallet that receives the 1% commission on each donation
NEXT_PUBLIC_PLATFORM_WALLET=

# WalletConnect / Reown AppKit (https://dashboard.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# POD NFT mint authority (server-side secret for minting; fund with SOL for tx fees)
POD_NFT_MINT_AUTHORITY_SECRET=
POD_NFT_MINT_AUTHORITY_PUBLIC_KEY=
NEXT_PUBLIC_POD_NFT_MINT_AUTHORITY=
NEXT_PUBLIC_POD_COLLECTION_MINT=

# IPFS / Pinata (for NFT metadata and images)
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

NEXT_PUBLIC_APP_NAME=We Love Dogs
NEXT_PUBLIC_APP_URL=http://localhost:3000
